; C3DRenderer::DrawMeshes' shader: map_cache.cpp's tiles, projected and lit as render.v.pica does the gbh_* vertices.
; The uniforms up to anyLights sit in render.v.pica's registers, so its lights carry over; projection holds the draw's.

; The clip position per local x, per local y and at (0, 0); the world position of (0, 0) less the light origin.
.fvec projection[4]
.fvec ambient[2]
.fvec lights[88]
.ivec lightLoop
.bool anyLights
.bool meshLit

.constf consts(0.0, 1.0, 0.00392156862, 0.0000001)
.constf more(-0.5, 255.0, 2.5, -2.0)
.alias zeros consts.xxxx
.alias ones consts.yyyy
.alias inv255 consts.zzzz
.alias tiny consts.wwww

.out outpos position
.out outclr color
.out outtc0 texcoord0

; v0 = local x, local y and shade bytes, v1 = (u, v), v2 = the eye as render.v.pica's v4
.alias inpos v0
.alias intex v1
.alias ineye v2

.proc main
    mul r0, projection[0], inpos.xxxx
    mad r0, inpos.yyyy, projection[1], r0
    add r1, projection[2], r0
    add r3, r1.wwww, -ineye.yyyy
    mul r3, ineye.xxxx, r3
    sge r4, r1.wwww, ineye.zzzz
    slt r5, r1.wwww, ineye.wwww
    mul r4, r4, r5
    mad r1.y, r3, r4, r1
    mov outpos, r1
    mov outtc0, intex

    ; the colour bytes (shade, shade, shade, 255)
    mov r10, inpos.zzzz
    mov r10.w, more.yyyy
    ifu meshLit
        mov r7, projection[3]
        add r7.xy, r7, inpos
        mul r7.w, inv255, inpos.zzzz
        mul r8, more.zzzz, r7.zzzz
        mov r9, ones
        mov r5, zeros
        ifu anyLights
            for lightLoop
                ; radius - distance, at least 0
                add r0, -lights[aL], r7
                dp3 r1, r0, r0
                max r1, tiny, r1
                rsq r2, r1
                mul r1, r1, r2
                add r1, lights[aL], -r1
                max r1, zeros, r1
                ; times 1 - smoothstep(t), t = (z - ceiling) / kCeilingFade clamped: t * t * (1 + 2 * (1 - t))
                add r3, -lights[aL+1].wwww, r8
                max r3, zeros, r3
                min r3, ones, r3
                add r4, ones, -r3
                mad r4, r4, -more.wwww, r9
                mul r4, r4, r3
                mul r4, r4, r3
                mad r4, -r4, r1.wwww, r1.wwww
                mul r6, lights[aL+1], r4
                add r5, r5, r6
            .end
        .end
        ; min(255, floor(shade * c * light + ambient)), alpha as given
        mul r0, r7.wwww, r10
        mul r0, r0, r5
        add r0, ambient[0], r0
        mul r1, ambient[1], r10
        add r0, r0, r1
        flr r0, r0
        min r0, more.yyyy, r0
        mov r0.w, r10.w
        mul outclr, inv255, r0
    .else
        mul outclr, inv255, r10
    .end
    end
.end
